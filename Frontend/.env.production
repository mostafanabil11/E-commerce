# Non-secret production configuration, committed on purpose so a deploy needs no
# manual setup for these. Vercel dashboard variables override anything here.
#
# NEXTAUTH_SECRET is deliberately NOT here — it is a real secret and must be set
# in the Vercel dashboard (Settings -> Environment Variables).

# Backend API, including the /api/v1 prefix
API=https://novacart-api-el8p.onrender.com/api/v1

# Public origin of this storefront: NextAuth callbacks and Stripe return URLs
NEXTAUTH_URL=https://novacart-acme-4d41.vercel.app
NEXT_URL=https://novacart-acme-4d41.vercel.app
