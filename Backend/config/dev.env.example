PORT = 5000
PUBLIC_URL = http://localhost:5000
FRONTEND_URL = http://localhost:3000
DB_URI = "mongodb://localhost:27017/E-commerce_App"
SALT_ROUNDS = 12
JWT_SECRET = super_secret_jwt_key_change_in_production
JWT_EXPIRATION = 1h
JWT_REFRESH_SECRET = super_secret_refresh_jwt_key_change_in_production
JWT_REFRESH_EXPIRATION = 7d
# Brevo transactional email (https://app.brevo.com -> SMTP & API -> API Keys)
BREVO_API_KEY = your_brevo_api_key
# Must be a sender verified in Brevo. Falls back to EMAIL_FROM if unset.
BREVO_SENDER_EMAIL = 
BREVO_SENDER_NAME = NovaCart
EMAIL_USER = your_email@gmail.com
EMAIL_PASS = your_email_app_password
EMAIL_FROM = "E-Commerce App <your_email@gmail.com>"
OTP_EXPIRATION_MINUTES = 10
REDIS_ENABLED = true
REDIS_HOST = localhost
REDIS_PORT = 6379
STRIPE_WEBHOOK_SECRET = whsec_your_stripe_webhook_secret
STRIPE_SECRET_KEY = sk_test_your_stripe_secret_key
PAYMOB_API_KEY = your_paymob_api_key
PAYMOB_INTEGRATION_ID = your_paymob_integration_id
PAYMOB_IFRAME_ID = your_paymob_iframe_id
PAYMOB_HMAC_SECRET = your_paymob_hmac_secret
