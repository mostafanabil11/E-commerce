<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; margin: 0; padding: 20px; color: #333; }
    .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
    .header { background: #3182ce; color: #ffffff; padding: 24px; text-align: center; }
    .header h1 { margin: 0; font-size: 24px; font-weight: 600; }
    .content { padding: 24px; }
    .status-badge { display: inline-block; background: #ebf8ff; color: #2b6cb0; font-weight: bold; padding: 8px 16px; border-radius: 20px; font-size: 16px; margin: 10px 0; }
    .order-info { background: #f8fafc; border-radius: 6px; padding: 16px; margin-bottom: 20px; }
    .order-info p { margin: 6px 0; font-size: 14px; }
    .footer { background: #edf2f7; padding: 16px; text-align: center; font-size: 12px; color: #718096; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Order Status Update</h1>
    </div>
    <div class="content">
      <p>Hi <strong><%= name %></strong>,</p>
      <p>The status of your order <strong>#<%= order.orderCode %></strong> has been updated:</p>
      
      <div style="text-align: center;">
        <span class="status-badge"><%= status %></span>
      </div>

      <div class="order-info">
        <p><strong>Order Total:</strong> <%= order.totalPrice %> EGP</p>
        <p><strong>Payment Status:</strong> <%= order.paymentStatus %></p>
        <p><strong>Shipping Address:</strong> <%= order.shippingAddress.street %>, <%= order.shippingAddress.city %>, <%= order.shippingAddress.country %></p>
      </div>

      <p>Thank you for shopping with us!</p>
    </div>
    <div class="footer">
      <p>E-Commerce Store &bull; All rights reserved.</p>
    </div>
  </div>
</body>
</html>
