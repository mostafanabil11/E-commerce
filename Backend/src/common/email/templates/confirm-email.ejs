<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Confirm Your Email</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        background-color: #f4f6f9;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding: 40px 16px;
      }
      .wrapper {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
      }
      .header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 40px 32px;
        text-align: center;
      }
      .header h1 {
        color: #ffffff;
        font-size: 26px;
        font-weight: 700;
        letter-spacing: -0.5px;
      }
      .header p {
        color: rgba(255, 255, 255, 0.85);
        margin-top: 6px;
        font-size: 14px;
      }
      .body {
        padding: 40px 32px;
      }
      .greeting {
        font-size: 18px;
        font-weight: 600;
        color: #1a1a2e;
        margin-bottom: 12px;
      }
      .description {
        font-size: 14px;
        color: #555;
        line-height: 1.7;
        margin-bottom: 32px;
      }
      .otp-label {
        font-size: 12px;
        font-weight: 600;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 12px;
      }
      .otp-box {
        background: #f0f0ff;
        border: 2px dashed #667eea;
        border-radius: 12px;
        padding: 24px;
        text-align: center;
        margin-bottom: 32px;
      }
      .otp-code {
        font-size: 42px;
        font-weight: 800;
        letter-spacing: 10px;
        color: #764ba2;
      }
      .expiry-note {
        font-size: 13px;
        color: #e05252;
        text-align: center;
        margin-bottom: 32px;
        font-weight: 500;
      }
      .divider {
        border: none;
        border-top: 1px solid #eee;
        margin-bottom: 24px;
      }
      .footer-note {
        font-size: 12px;
        color: #aaa;
        line-height: 1.6;
        text-align: center;
      }
      .footer {
        background: #f9f9f9;
        padding: 20px 32px;
        text-align: center;
        border-top: 1px solid #eee;
      }
      .footer p {
        font-size: 12px;
        color: #bbb;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <div class="header">
        <h1>E-Commerce App</h1>
        <p>Email Verification</p>
      </div>

      <div class="body">
        <p class="greeting">Hello, <%= name %> 👋</p>
        <p class="description">
          Thanks for signing up! To complete your registration, please use the
          one-time verification code below. This code confirms your email
          address and activates your account.
        </p>

        <p class="otp-label">Your verification code</p>
        <div class="otp-box">
          <span class="otp-code"><%= otp %></span>
        </div>

        <p class="expiry-note">⏱ This code expires in <strong>10 minutes</strong>.</p>

        <hr class="divider" />

        <p class="footer-note">
          If you didn't create an account with us, you can safely ignore this
          email. Someone may have entered your email address by mistake.
        </p>
      </div>

      <div class="footer">
        <p>&copy; <%= new Date().getFullYear() %> E-Commerce App. All rights reserved.</p>
      </div>
    </div>
  </body>
</html>
